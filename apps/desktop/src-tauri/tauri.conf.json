{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LLM Wiki",
  "version": "0.1.0",
  "identifier": "com.llmwiki.desktop",
  "build": {
    "beforeDevCommand": "node ../../scripts/prepare-pi-runtime.mjs && pnpm --filter @llm-wiki/desktop dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node ../../scripts/prepare-pi-runtime.mjs && pnpm --filter @llm-wiki/desktop build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LLM Wiki",
        "decorations": true,
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "pi-runtime/index.js": "pi-runtime/index.js"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
